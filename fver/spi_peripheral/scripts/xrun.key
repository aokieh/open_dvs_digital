database -open waves -into waves.shm -default
probe -create -shm tb.CIPO tb.COPI tb.SCK tb.CS_N tb.i_spi_peripheral.addr_valid tb.i_spi_peripheral.cycle_count tb.i_spi_peripheral.en_rx_addr tb.i_spi_peripheral.en_rx_opcode tb.i_spi_peripheral.en_rx_rdata tb.i_spi_peripheral.rx_data_3 tb.i_spi_peripheral.rx_data_0 tb.i_spi_peripheral.rx_data_1 tb.i_spi_peripheral.rx_data_2 tb.we_reg tb.i_spi_peripheral.mem_write_next_re tb.addr_reg tb.clk tb.rdata_reg tb.rst_n tb.shift_en_fifo tb.spi_ctrl tb.wdata_reg tb.wmask_reg -depth 2 -all
reset
run
exit
